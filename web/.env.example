# Committed on purpose: these are build-time public values, not secrets.
#
# The demo build has no backend and no API keys of any kind -- the "cluster" it
# shows is simulated in the visitor's browser. There is nothing here to leak,
# which is a consequence of the zero-backend architecture rather than an
# accident.
VITE_HAZE_PUBLIC_URL=https://haze-38586.web.app
VITE_HAZE_REPO_URL=https://github.com/CodeMaster747/Haze
